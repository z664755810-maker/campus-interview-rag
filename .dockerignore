# Docker 构建时排除这些文件（不影响 Git）
# 作用类似 .gitignore，但只对 Docker 构建生效
.git
.gitignore
.workbuddy
README.md

# 后端
backend/.env
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/chroma_db

# 前端：保留源码进构建上下文（Dockerfile 多阶段会重新 npm install / build）
# 仅排除本地依赖与构建产物，避免把宿主机 node_modules 带进镜像
frontend/node_modules
frontend/dist

# 部署元数据（Railway 自己会读，但不应进镜像）
Procfile
railway.json
nixpacks.toml
