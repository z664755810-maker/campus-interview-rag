# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
ZHIPU_API_KEY=your_zhipu_api_key_here
GLM_MODEL=glm-4-flash
CHROMA_PERSIST_DIR=./chroma_db
TOP_K=4

# ── Embedding provider 切换 ────────────────────────────────
# 智谱免费档 embedding 接口持续 429 限流，默认改用阿里百炼 text-embedding-v3
# 可选值：zhipu | dashscope
EMBEDDING_PROVIDER=dashscope
# 阿里百炼 DashScope（向量化用，免费 50 万 token / 90 天）
# 申请：https://bailian.console.aliyun.com/ → API-Key 管理 → 创建
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# 阶段4 业务加固：客户端 API Key（可逗号配置多个，空则退化为不鉴权）
API_KEYS=dev-rag-2026
# 限流：单 IP 每分钟最大请求数
RATE_LIMIT_PER_MINUTE=30

# ── 部署相关（生产/部署时配置） ────────────────────────────
# 跨域白名单：生产环境填前端真实域名，逗号分隔。
# 例：ALLOWED_ORIGINS=https://campus-interview-rag.vercel.app
ALLOWED_ORIGINS=*
