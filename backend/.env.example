# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
ZHIPU_API_KEY=your_zhipu_api_key_here
GLM_MODEL=glm-4-flash
CHROMA_PERSIST_DIR=./chroma_db
TOP_K=4

# 阶段4 业务加固：客户端 API Key（可逗号配置多个，空则退化为不鉴权）
API_KEYS=dev-rag-2026
# 限流：单 IP 每分钟最大请求数
RATE_LIMIT_PER_MINUTE=30

# ── 部署相关（生产/部署时配置） ────────────────────────────
# 跨域白名单：生产环境填前端真实域名，逗号分隔。
# 例：ALLOWED_ORIGINS=https://campus-interview-rag.vercel.app
ALLOWED_ORIGINS=*
